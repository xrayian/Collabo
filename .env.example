# ==============================================================================
# Collabo — Environment Configuration Example (.env.example)
# Duplicate this file as '.env' or '.env.local' and customize for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Next.js Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Mediasoup SFU & WebRTC Configuration
# ------------------------------------------------------------------------------
# The local interface IP that the Mediasoup SFU binds to (usually 0.0.0.0 or 127.0.0.1)
MEDIASOUP_LISTEN_IP=0.0.0.0

# The publicly accessible IPv4 or IPv6 address handed out to WebRTC clients in ICE candidates.
# For Local Development: use '127.0.0.1'
# For Production VPS: replace with your server's public IP (e.g. 203.0.113.10)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# UDP port range allocated for WebRTC audio/video RTP packets (Must be open on firewall)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# Worker logging level ('debug' | 'warn' | 'error' | 'none')
MEDIASOUP_LOG_LEVEL=warn

# ------------------------------------------------------------------------------
# 3. Collabo Desktop (Electron Host App) Settings
# ------------------------------------------------------------------------------
# The URL loaded by the Electron Desktop Host controller window
COLLABO_HOST_URL=http://localhost:3000/desktop-host

# ------------------------------------------------------------------------------
# 4. Production & Reverse Proxy Settings (Docker / Caddy)
# ------------------------------------------------------------------------------
# The domain name for automatic SSL certificate provisioning via Caddy
DOMAIN=collabo.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Automated Test Suite URLs (Optional)
# ------------------------------------------------------------------------------
COLLABO_HTTP_URL=http://localhost:3000
COLLABO_WS_URL=ws://localhost:3000/ws
